@echo off
REM Template for local build credentials.
REM
REM Usage:
REM   copy social_credentials.local.bat.example social_credentials.local.bat
REM   then replace the three placeholder values below.
REM
REM Why this is a separate file: these are third-party service credentials
REM extracted from the official app. The repository deliberately ships NO
REM values for them. lib/social_credentials.dart reads them from build
REM parameters, so the code always compiles even without this file.
REM
REM social_credentials.local.bat is listed in .gitignore.

set "KAKAO_CLIENT_ID=PUT_YOUR_KAKAO_REST_API_KEY_HERE"
set "NAVER_CLIENT_ID=PUT_YOUR_NAVER_CLIENT_ID_HERE"
set "NAVER_CLIENT_SECRET=PUT_YOUR_NAVER_CLIENT_SECRET_HERE"
